{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agentic Lab: API и панель",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve_ui.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Agentic Lab: текущий тест",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "-s", "${file}"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
