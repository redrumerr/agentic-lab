LAB_SANDBOX_TOKEN=replace-with-unique-random-sandbox-token
LAB_EVALUATOR_TOKEN=replace-with-unique-random-evaluator-token
# benchmark init saves the prepared box; UI and benchmark run select it automatically.
# Optional explicit override:
# LAB_VAGRANT_BOX=bento/ubuntu-24.04
# Escape scenarios install pinned OpenClaw 2026.9.6 in the VM sandbox by default.
# LAB_OPENCLAW_VERSION=2026.x.y
# LAB_OPENCLAW_COMMAND=openclaw agent --local --timeout 7000 --message
# If your host UID/GID differ from 1000, set both for the UI container.
# LAB_UI_UID=1000
# LAB_UI_GID=1000
